# Optional override. Acorn Desktop reports to kevin-mow by default.
VITE_SENTRY_DSN=

# Native-only secrets. Never prefix these with VITE_ — Vite would inline them
# into the shipped JavaScript bundle. `pnpm -F desktop tauri build` (and
# `tauri dev`) load these into the native process so Deepgram / Default LLM
# and Google Calendar work for users without pasting their own keys.
#
# GitHub Actions needs the same values as repository secrets so CI-built
# installers embed them: GOOGLE_CALENDAR_CLIENT_SECRET,
# ACORN_DEFAULT_STT_API_KEY, ACORN_DEFAULT_LLM_API_KEY.
#
# Google Calendar: create an OAuth client of type "Desktop app" in Google
# Cloud Console. Loopback redirects (http://127.0.0.1) are already used by
# the app. If you create a new client, update GOOGLE_CALENDAR_CLIENT_ID in
# src/calendar/google-oauth/oauth.ts.
GOOGLE_CALENDAR_CLIENT_SECRET=
ACORN_DEFAULT_STT_API_KEY=
ACORN_DEFAULT_LLM_API_KEY=

# Non-secret LLM defaults (safe in the UI bundle).
VITE_ACORN_DEFAULT_LLM_KIND=openai
VITE_ACORN_DEFAULT_LLM_MODEL=
VITE_ACORN_DEFAULT_LLM_BASE_URL=
